# ==========================================
# RAMGOLD GYM - PAYMENT & SUBSCRIPTION CONFIG
# ==========================================

# 1. Razorpay Public API Key (Client-side)
# Obtain from: https://dashboard.razorpay.com/app/keys
# For testing: rzp_test_xxxxxxxxxxxxxx
# For production: rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_sample_key_12345

# 2. Razorpay Secret Key (Backend Server Only - NEVER expose in client bundles)
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# 3. Razorpay Webhook Secret (Backend verification of events)
# Obtain from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# 4. Business & Tax Configuration (India)
VITE_GYM_LEGAL_NAME=RAMGOLD FITNESS AND ATHLETICS
VITE_GYM_GSTIN=21AAACR1234F1Z5
VITE_GYM_SUPPORT_PHONE=+919876543210
VITE_GYM_SUPPORT_EMAIL=concierge@ramgoldgym.com

# 5. Backend Server Endpoint (For creating orders / subscriptions & handling webhooks)
VITE_API_BASE_URL=http://localhost:5000/api
